# Dependency-only remediation of compiled images; no product source input.
ARG PROTECTED_IMAGE
ARG SERVICE=guardrail
FROM ${PROTECTED_IMAGE} AS compiled
FROM python:3.12-slim-bookworm@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4 AS openssl-package
USER root
RUN apt-get update && cd /tmp \
    && apt-get download 'libssl3=3.0.22-1~deb12u2' \
    && echo 'cb4784740daa9b3b0eaea2b444bbefa686794afbbf3d678d238c1fd9875f2efd  libssl3_3.0.22-1~deb12u2_amd64.deb' | sha256sum -c - \
    && dpkg-deb -x 'libssl3_3.0.22-1~deb12u2_amd64.deb' /vendor \
    && mkdir -p /vendor-evidence \
    && python -c "import json,os,sys; print(json.dumps({'version':list(sys.version_info[:3]),'cache_tag':sys.implementation.cache_tag,'source_sha256':os.environ['PYTHON_SHA256']}))" > /vendor-evidence/python.json \
    && dpkg-deb -f 'libssl3_3.0.22-1~deb12u2_amd64.deb' > /vendor-evidence/control.txt \
    && cp /vendor/usr/share/doc/libssl3/copyright /vendor-evidence/copyright
FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f AS builder
ARG SERVICE
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && apt-get upgrade -y --no-install-recommends \
    && echo 'deb http://deb.debian.org/debian sid main' > /etc/apt/sources.list.d/uter-sid.list \
    && apt-get update && apt-get install -y --no-install-recommends libsqlite3-0=3.54.1-2 \
    && python -c "import hashlib,sqlite3; p={line.split()[-1] for line in open('/proc/self/maps') if 'libsqlite3.so' in line}; assert sqlite3.sqlite_version=='3.54.1' and len(p)==1 and hashlib.sha256(open(p.pop(),'rb').read()).hexdigest()=='225ceb839db2c1dd484cfcaa5ef9fbdd429eb1d5f1e0c39fbd50150bca5fc7bc'" \
    && rm /etc/apt/sources.list.d/uter-sid.list && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 uter && useradd -u 10001 -g 10001 -m uter \
    && mkdir -p /app /var/lib/uter/audit && chown -R 10001:10001 /app /home/uter /var/lib/uter
COPY --from=compiled /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=compiled --chown=10001:10001 /app /app
COPY --from=compiled --chown=10001:10001 /home/uter/.cache/huggingface /home/uter/.cache/huggingface
COPY --from=openssl-package /vendor/usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/local/lib/libssl.so.3
COPY --from=openssl-package /vendor/usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/local/lib/libcrypto.so.3
COPY --from=openssl-package /vendor/usr/lib/x86_64-linux-gnu/ossl-modules /usr/local/lib/ossl-modules
COPY --from=openssl-package /vendor-evidence /usr/local/share/uter-openssl-package
COPY --from=openssl-package /usr/local/lib/python3.12/lib-dynload/_ssl*.so /usr/local/lib/python3.12/lib-dynload/
COPY --from=openssl-package /usr/local/lib/python3.12/lib-dynload/_hashlib*.so /usr/local/lib/python3.12/lib-dynload/
ENV LD_LIBRARY_PATH=/usr/local/lib OPENSSL_MODULES=/usr/local/lib/ossl-modules
RUN python -c "import json,os,ssl,sys; x=json.load(open('/usr/local/share/uter-openssl-package/python.json')); assert x=={'version':list(sys.version_info[:3]),'cache_tag':sys.implementation.cache_tag,'source_sha256':os.environ['PYTHON_SHA256']} and ssl.OPENSSL_VERSION.startswith('OpenSSL 3.0.22 '), (x,sys.version,ssl.OPENSSL_VERSION)"
RUN python -m ensurepip && case "$SERVICE" in \
      guardrail) python -m pip install --no-cache-dir PyJWT==2.14.0 certifi==2026.10.19 ;; \
      agent) python -m pip install --no-cache-dir Pillow==13.0.0 certifi==2026.10.19 ;; \
      *) exit 1 ;; \
    esac \
    && python -m pip check \
    && python -m pip freeze > /dependency-versions.txt \
    && python -m pip uninstall -y pip wheel
COPY runtime_rootfs.py /runtime_rootfs.py
RUN python /runtime_rootfs.py && cp /dependency-versions.txt /runtime-rootfs/usr/share/uter/dependency-versions.txt

FROM scratch AS guardrail-runtime
COPY --from=builder /runtime-rootfs /
ENV PATH=/usr/local/bin LD_LIBRARY_PATH=/usr/local/lib HOME=/home/uter \
    HF_HOME=/home/uter/.cache/huggingface PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UVICORN_PORT=8000 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt OPENSSL_MODULES=/usr/local/lib/ossl-modules
LABEL io.uter.security-overlay="2026-10-28.1"
WORKDIR /app
USER 10001:10001
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--no-server-header", "--no-date-header"]
FROM guardrail-runtime AS agent-runtime
ENV UVICORN_PORT=8001
FROM ${SERVICE}-runtime AS final
