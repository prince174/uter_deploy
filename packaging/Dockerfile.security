# Dependency-only remediation of compiled images; no product source input.
ARG PROTECTED_IMAGE
ARG SERVICE=guardrail
FROM ${PROTECTED_IMAGE} AS compiled
FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f AS builder
ARG SERVICE
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 uter && useradd -u 10001 -g 10001 -m uter \
    && mkdir -p /app /var/lib/uter/audit && chown -R 10001:10001 /app /home/uter /var/lib/uter
COPY --from=compiled /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=compiled --chown=10001:10001 /app /app
COPY --from=compiled --chown=10001:10001 /home/uter/.cache/huggingface /home/uter/.cache/huggingface
RUN python -m ensurepip && case "$SERVICE" in \
      guardrail) python -m pip install --no-cache-dir PyJWT==2.14.0 certifi==2026.10.19 ;; \
      agent) python -m pip install --no-cache-dir fastembed==0.9.1 Pillow==13.0.0 certifi==2026.10.19 ;; \
      *) exit 1 ;; \
    esac \
    && python -m pip check \
    && python -m pip freeze > /dependency-versions.txt \
    && python -m pip uninstall -y pip wheel
COPY runtime_rootfs.py /runtime_rootfs.py
RUN python /runtime_rootfs.py && cp /dependency-versions.txt /runtime-rootfs/usr/share/uter/dependency-versions.txt

FROM scratch AS guardrail-runtime
COPY --from=builder /runtime-rootfs /
ENV PATH=/usr/local/bin LD_LIBRARY_PATH=/usr/local/lib HOME=/home/uter \
    HF_HOME=/home/uter/.cache/huggingface PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UVICORN_PORT=8000 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
LABEL io.uter.security-overlay="2026-10-28.1"
WORKDIR /app
USER 10001:10001
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--no-server-header", "--no-date-header"]
FROM guardrail-runtime AS agent-runtime
ENV UVICORN_PORT=8001
FROM ${SERVICE}-runtime AS final
